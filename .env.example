# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Which image provider to use: "cloudflare" (default) or "openai"
# ---------------------------------------------------------------------------
AI_PROVIDER=cloudflare

# ---------------------------------------------------------------------------
# Option A — Cloudflare Workers AI (default; runs on the free tier)
#
# 1. Create a free account at https://dash.cloudflare.com/sign-up
# 2. Account ID: on the dashboard, open Workers & Pages — the Account ID is
#    shown in the right-hand sidebar.
# 3. API token: My Profile -> API Tokens -> Create Token -> use the
#    "Workers AI" template (read access is enough). Copy it once; it is not
#    shown again.
#
# The free Workers plan includes a daily neuron allowance, so no card is
# needed. Requests stop with an error when the daily allowance runs out
# rather than billing you.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Workers AI image model (defaults to @cf/black-forest-labs/flux-2-klein-4b).
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Optional tuning (Cloudflare / diffusion models only).
# AI_STRENGTH: 0-1. How far to move from the uploaded photo. Lower keeps more
#   of the original room. 0.4-0.6 is the useful range for room redesigns;
#   above ~0.7 the model starts inventing a different room.
AI_STRENGTH=0.5
# AI_GUIDANCE: how strictly to follow the prompt. 7.5 is a sane default.
AI_GUIDANCE=7.5
# AI_STEPS: diffusion steps. Workers AI caps SDXL at 20.
AI_STEPS=20

# ---------------------------------------------------------------------------
# Option B — OpenAI image editing provider (first-class, paid)
#
# Used when AI_PROVIDER=openai. Uses the OpenAI /v1/images/edits endpoint
# with high input fidelity to preserve room geometry, perspective, and structure.
# (Server-side only — never exposed to the frontend/browser).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Note: AI_API_KEY, AI_IMAGE_MODEL, and AI_API_BASE_URL are supported as fallbacks.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
